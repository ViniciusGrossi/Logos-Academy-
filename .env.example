# Demonstração local: mantenha false em qualquer ambiente publicado.
NEXT_PUBLIC_DEMO_MODE=false
DEMO_LOGIN_EMAIL=local-demo@example.com
DEMO_LOGIN_PASSWORD=local-demo-password
